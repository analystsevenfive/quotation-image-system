# ==============================================================================
# Quotation Image Automation System - Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend (FastAPI / Python) - apps/api
# ------------------------------------------------------------------------------
# Port for the FastAPI server (Default: 8000)
PORT=8000

# Required for Python module resolution when running outside apps/api
PYTHONPATH=apps/api

# Path to the local catalog snapshot (contains 40,194 products)
# Used automatically if DATABASE_URL is not set.
PRODUCTS_JSON=.data/products.json

# Optional: PostgreSQL / Supabase connection string
# If set, the API queries PostgreSQL instead of the local JSON file.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Allowed Host headers (comma-separated or '*' for all)
ALLOWED_HOSTS=*

# Allowed Origins for CORS (comma-separated or '*' for all)
# Example for production + local:
ALLOWED_ORIGINS=https://quotation-image-system.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Frontend (Next.js / TypeScript) - apps/web
# ------------------------------------------------------------------------------
# API URL that Next.js rewrites /api/* requests to.
# On Vercel: Set to your Render backend URL (e.g., https://quotation-api-h4ta.onrender.com)
# In local development: Defaults to http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
